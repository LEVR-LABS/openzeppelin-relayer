              "path": ["api", "v1", "signers", "{{SIGNER_ID}}"]
            }
          }
        },
        {
          "name": "Update Signer",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/signers/{{SIGNER_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "signers", "{{SIGNER_ID}}"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"config\": {\n    \"region\": \"ap-south-1\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Signer",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/signers/{{SIGNER_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "signers", "{{SIGNER_ID}}"]
            }
          }
        }
      ]
    },

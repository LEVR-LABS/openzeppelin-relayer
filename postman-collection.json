{
  "info": {
    "name": "OpenZeppelin Relayer",
    "description": "Postman collection for the OpenZeppelin Relayer used by LEVR.\n\nManages relayers, transactions, signing, signers, notifications, networks, plugins, and API keys. Auth via `Authorization` header with raw API key.\n\nLEVR relayer groups: game_admin, liquidator, feed_provider, match_maker (each with multiple relayer instances per environment).\n\n**Variables:**\n- `RELAYER_BASE_URL`: Base URL (e.g. `http://localhost:8080`)\n- `API_KEY`: Relayer API key\n- `RELAYER_ID`: Relayer instance ID (e.g. `game_admin_10143_1`)\n- `TRANSACTION_ID`: Transaction ID\n- `NONCE`: Transaction nonce\n- `SIGNER_ID`: Signer ID\n- `NOTIFICATION_ID`: Notification ID\n- `NETWORK_ID`: Network ID (e.g. `evm:monad-testnet`)\n- `PLUGIN_ID`: Plugin ID\n- `API_KEY_ID`: API key ID",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "RELAYER_BASE_URL", "value": "http://localhost:8080", "type": "string" },
    { "key": "API_KEY", "value": "", "type": "string" },
    { "key": "RELAYER_ID", "value": "game_admin_10143_1", "type": "string" },
    { "key": "TRANSACTION_ID", "value": "", "type": "string" },
    { "key": "NONCE", "value": "", "type": "string" },
    { "key": "SIGNER_ID", "value": "", "type": "string" },
    { "key": "NOTIFICATION_ID", "value": "", "type": "string" },
    { "key": "NETWORK_ID", "value": "evm:monad-testnet", "type": "string" },
    { "key": "PLUGIN_ID", "value": "", "type": "string" },
    { "key": "API_KEY_ID", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "value", "value": "{{API_KEY}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "description": "Public health and readiness endpoints (no auth required).",
      "item": [
        {
          "name": "Liveness Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/health",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Returns 200 OK with body 'OK' (text/plain)."
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/ready",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "ready"]
            },
            "description": "Returns JSON { ready, fd_count, fd_limit, fd_usage_percent, close_wait_count }. Returns 503 if unhealthy."
          }
        }
      ]
    },
    {
      "name": "Relayers",
      "description": "CRUD operations on relayer instances.",
      "item": [
        {
          "name": "List Relayers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers?page=1&per_page=50",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Create Relayer",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"my_relayer_1\",\n  \"name\": \"My Relayer\",\n  \"network\": \"evm:monad-testnet\",\n  \"signer_id\": \"{{SIGNER_ID}}\",\n  \"paused\": false,\n  \"policies\": {\n    \"min_balance\": 1000000000000000000,\n    \"eip1559_pricing\": true,\n    \"gas_limit_estimation\": true\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Relayer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}"]
            }
          }
        },
        {
          "name": "Update Relayer",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}"]
            },
            "header": [{ "key": "Content-Type", "value": "application/merge-patch+json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paused\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "JSON Merge Patch (RFC 7396). Only include fields to update."
          }
        },
        {
          "name": "Delete Relayer",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}"]
            },
            "description": "Fails if the relayer has active transactions."
          }
        },
        {
          "name": "Get Relayer Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/status",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "status"]
            }
          }
        },
        {
          "name": "Get Relayer Balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/balance",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "balance"]
            },
            "description": "Returns { balance, unit }."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "description": "Send, list, get, replace, and cancel transactions.",
      "item": [
        {
          "name": "Send Transaction",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"0x...\",\n  \"value\": \"0\",\n  \"data\": \"0x...\",\n  \"gas_limit\": 200000\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/?page=1&per_page=20",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Transaction",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/{{TRANSACTION_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "Replace Transaction",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/{{TRANSACTION_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "{{TRANSACTION_ID}}"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"0x...\",\n  \"value\": \"0\",\n  \"data\": \"0x...\",\n  \"gas_limit\": 200000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Replace a pending transaction with updated parameters."
          }
        },
        {
          "name": "Cancel Transaction",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/{{TRANSACTION_ID}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "Get Transaction by Nonce",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/by-nonce/{{NONCE}}",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "by-nonce", "{{NONCE}}"]
            }
          }
        },
        {
          "name": "Delete Pending Transactions",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/pending",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "pending"]
            },
            "description": "Delete all pending transactions for this relayer."
          }
        }
      ]
    },
    {
      "name": "Sponsored Transactions",
      "description": "Gas abstraction / sponsored (gasless) transaction endpoints.",
      "item": [
        {
          "name": "Quote Sponsored Transaction",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/sponsored/quote",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "sponsored", "quote"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"0x...\",\n  \"value\": \"0\",\n  \"data\": \"0x...\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Estimate fees for a sponsored (gasless) transaction. Returns { estimated_fee, conversion_rate }."
          }
        },
        {
          "name": "Build Sponsored Transaction",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/transactions/sponsored/build",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "transactions", "sponsored", "build"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"0x...\",\n  \"value\": \"0\",\n  \"data\": \"0x...\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Build a sponsored transaction with fee payments. Returns { transaction, fee_in_token, fee_in_stroops, fee_token, valid_until }."
          }
        }
      ]
    },
    {
      "name": "Signing",
      "description": "Sign raw data, EIP-712 typed data, and transactions.",
      "item": [
        {
          "name": "Sign Data",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/sign",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "sign"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"0x...\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sign raw data using the relayer's signer."
          }
        },
        {
          "name": "Sign Typed Data (EIP-712)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/sign-typed-data",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "sign-typed-data"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain_separator\": {},\n  \"primary_type\": \"Transfer\",\n  \"types\": {},\n  \"message\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sign EIP-712 typed data."
          }
        },
        {
          "name": "Sign Transaction",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/sign-transaction",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "sign-transaction"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction\": \"0x...\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sign a transaction (Stellar only)."
          }
        }
      ]
    },
    {
      "name": "JSON-RPC",
      "description": "Proxy JSON-RPC calls through a relayer.",
      "item": [
        {
          "name": "JSON-RPC Call",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/relayers/{{RELAYER_ID}}/rpc",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "relayers", "{{RELAYER_ID}}", "rpc"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_blockNumber\",\n  \"params\": []\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Signers",
      "description": "CRUD operations on signer configurations (AWS KMS, local keys, etc.).",
      "item": [

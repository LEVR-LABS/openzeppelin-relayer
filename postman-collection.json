    {
      "name": "Plugins",
      "description": "List and execute plugins.",
      "item": [
        {
          "name": "List Plugins",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/plugins?page=1&per_page=20",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "plugins"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Execute Plugin (POST)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{RELAYER_BASE_URL}}/api/v1/plugins/{{PLUGIN_ID}}/call?route=/",
              "host": ["{{RELAYER_BASE_URL}}"],
              "path": ["api", "v1", "plugins", "{{PLUGIN_ID}}", "call"],
              "query": [{ "key": "route", "value": "/", "description": "Plugin route path" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
